# Local Supabase Postgres (started by `make db`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Preprocessing cache and run outputs (~ is expanded)
DATA_DIR=~/448-data
# Public IBL server
ONE_BASE_URL=https://openalyx.internationalbrainlab.org
# Where ONE stores downloaded IBL files (~ is expanded)
ONE_CACHE_DIR=~/448-data/ONE
# 1 = synthetic IBL data instead of real downloads (dev and tests)
IBL_FAKE=1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
